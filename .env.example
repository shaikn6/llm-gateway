ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434
# docker compose service name; for a native run use redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
# REQUIRED. Comma-separated client keys accepted in the X-API-Key header.
# There is no default: the gateway refuses to start while this is empty.
# Generate one with:  openssl rand -hex 24
API_KEYS=
# Local development only: start without API_KEYS and accept the built-in
# keys dev-key-1 / dev-key-2. Never enable on a reachable host.
GATEWAY_DEV_MODE=false
LOG_LEVEL=INFO
